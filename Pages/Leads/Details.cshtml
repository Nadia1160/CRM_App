@page "{id:int}"
@model CRM_APP.Pages.Leads.DetailsModel
@{
    ViewData["Title"] = $"Lead Details - {Model.Lead?.Name}";
}

<h2>Lead: @Model.Lead?.Name</h2>
<p><strong>Status:</strong> @Model.Lead?.Status</p>
<p><strong>Email:</strong> @Model.Lead?.Email</p>
<p><strong>Phone:</strong> @Model.Lead?.Phone</p>
<p><strong>Company:</strong> @Model.Lead?.Company</p>
<p><strong>Source:</strong> @Model.Lead?.Source</p>

<hr />

<h3>Activities Timeline</h3>
@if (Model.Activities.Any())
{
    <ul class="list-group mb-4">
        @foreach (var act in Model.Activities)
        {
            <li class="list-group-item">
                <strong>@act.Type</strong> – @act.Subject
                <br />
                <small class="text-muted">@act.ActivityDate.ToLocalTime().ToString("g")</small>
                @if (!string.IsNullOrEmpty(act.Description))
                {
                    <div class="mt-1">@act.Description</div>
                }
            </li>
        }
    </ul>
}
else
{
    <p class="text-muted">No activities yet.</p>
}

<h4>Add New Activity</h4>
<partial name="_ActivityForm" model="new CRM_APP.Models.Activity { LeadId = Model.Lead?.Id }" />

<div class="mt-3">
    <a asp-page="./Index" class="btn btn-secondary">Back to Leads</a>
</div>