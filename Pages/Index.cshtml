@page
@model IndexModel
@{
    ViewData["Title"] = "Home - CRM Web APP";
}

<!-- Bootstrap Icons CDN (adds icons for cards) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    /* Hero gradient & animation */
    .hero {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 4rem 2rem;
        border-radius: 1rem;
        margin-bottom: 2rem;
        animation: fadeInDown 0.8s ease-out;
    }

    @@keyframes fadeInDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    /* Feature cards */
    .feature-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border-radius: 1rem;
        cursor: default;
        height: 100%;
    }

        .feature-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 1rem 2rem rgba(0,0,0,0.15) !important;
        }

    .feature-icon {
        font-size: 2.5rem;
        margin-bottom: 1rem;
        color: #0d6efd;
    }
    /* Demo panel */
    .demo-panel {
        background: #f8f9fa;
        border-radius: 1rem;
        padding: 1.5rem;
        margin-top: 2rem;
    }

    .live-filter-demo input {
        max-width: 300px;
        margin: 0 auto;
    }

    .demo-list li {
        transition: background 0.2s;
        padding: 0.5rem;
        border-radius: 0.5rem;
    }

        .demo-list li:hover {
            background: #e9ecef;
        }
</style>

<div class="container">
    <!-- Hero Section -->
    <div class="hero text-center">
        <h1 class="display-3 fw-bold">CRM Web App Demo</h1>
        <p class="lead mt-3">Enterprise‑grade solutions for real‑world ASP.NET Core challenges</p>
        <div class="mt-4">
            <a href="/Customers" class="btn btn-light btn-lg me-2 px-4">📋 View Customers</a>
            <a href="/Orders/Create" class="btn btn-outline-light btn-lg px-4">➕ Create Order</a>
            <a href="/Dashboard" class="btn btn-warning btn-lg px-4">📊 Dashboard</a>
        </div>
    </div>

    <!-- Features Section (4 cards) -->
    <div class="row g-4 mb-5">
        <div class="col-md-3 col-sm-6">
            <div class="card feature-card shadow-sm h-100 text-center p-3">
                <div class="card-body">
                    <i class="bi bi-file-pdf feature-icon"></i>
                    <h5 class="card-title">PDF Generation</h5>
                    <p class="card-text">Fixed configuration issues – export customer reports seamlessly.</p>
                    <span class="badge bg-success">Solved</span>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card feature-card shadow-sm h-100 text-center p-3">
                <div class="card-body">
                    <i class="bi bi-trash3 feature-icon"></i>
                    <h5 class="card-title">Cascade Delete</h5>
                    <p class="card-text">EF Core cascade delete properly configured – no orphaned orders.</p>
                    <span class="badge bg-success">Solved</span>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card feature-card shadow-sm h-100 text-center p-3">
                <div class="card-body">
                    <i class="bi bi-calculator feature-icon"></i>
                    <h5 class="card-title">JS Calculation</h5>
                    <p class="card-text">Accurate real‑time total with <code>parseFloat</code> and <code>toFixed</code>.</p>
                    <span class="badge bg-success">Solved</span>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card feature-card shadow-sm h-100 text-center p-3">
                <div class="card-body">
                    <i class="bi bi-funnel feature-icon"></i>
                    <h5 class="card-title">Smart Filter</h5>
                    <p class="card-text">Server‑side search by name/city – instant Razor Page filtering.</p>
                    <span class="badge bg-success">Solved</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Interactive Live Demo Panel (mocks filter & calculation) -->
    <div class="demo-panel">
        <h3 class="text-center mb-4"><i class="bi bi-lightbulb"></i> Live Interactive Demo</h3>
        <div class="row">
            <!-- Mock Filter Demo -->
            <div class="col-md-6 live-filter-demo text-center">
                <h5><i class="bi bi-search"></i> Filter Demo (mock data)</h5>
                <input type="text" id="mockSearch" class="form-control mt-2" placeholder="Filter names (e.g., Acme)" autocomplete="off">
                <ul id="mockList" class="list-unstyled mt-3 demo-list">
                    <li>Acme Corp</li>
                    <li>Beta LLC</li>
                    <li>Gamma Inc</li>
                    <li>Delta Ltd</li>
                </ul>
                <small class="text-muted">Type to see live filtering – replicates the real server filter behaviour.</small>
            </div>
            <!-- Mock Calculation Demo -->
            <div class="col-md-6 text-center">
                <h5><i class="bi bi-calculator-fill"></i> Price Calculator Demo</h5>
                <div class="row g-2 mt-2">
                    <div class="col-6">
                        <label>Quantity</label>
                        <input type="number" id="mockQty" class="form-control" value="2" step="1">
                    </div>
                    <div class="col-6">
                        <label>Unit Price ($)</label>
                        <input type="number" id="mockPrice" class="form-control" value="49.99" step="0.01">
                    </div>
                </div>
                <div class="mt-3">
                    <h4>Total: $<span id="mockTotal">99.98</span></h4>
                    <small class="text-muted">Uses <code>parseFloat</code> and <code>toFixed(2)</code> – exactly like the real order page.</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer / Portfolio note -->
    <footer class="mt-5 text-center text-muted border-top pt-3">
        <p>ASP.NET Core 8 · Razor Pages · Entity Framework Core · QuestPDF · Bootstrap 5</p>
        <p>All four original issues fixed and demonstrated.</p>
    </footer>
</div>

<!-- Interactive JavaScript for the two live demos -->
<script>
    // Mock filter demo
    const mockSearch = document.getElementById('mockSearch');
    const mockItems = document.querySelectorAll('#mockList li');
    mockSearch.addEventListener('input', function(e) {
        const term = e.target.value.toLowerCase();
        mockItems.forEach(item => {
            const text = item.textContent.toLowerCase();
            item.style.display = text.includes(term) ? '' : 'none';
        });
    });

    // Mock calculation demo
    const qtyInput = document.getElementById('mockQty');
    const priceInput = document.getElementById('mockPrice');
    const totalSpan = document.getElementById('mockTotal');

    function updateMockTotal() {
        let qty = parseFloat(qtyInput.value);
        let price = parseFloat(priceInput.value);
        if (isNaN(qty)) qty = 0;
        if (isNaN(price)) price = 0;
        const total = qty * price;
        totalSpan.textContent = total.toFixed(2);
    }

    qtyInput.addEventListener('input', updateMockTotal);
    priceInput.addEventListener('input', updateMockTotal);
    updateMockTotal();
</script>