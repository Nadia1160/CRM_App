@page
@model CRM_APP.Pages.Accounts.DeleteModel
@{
    ViewData["Title"] = "Delete Account";
}

<h1>Delete Account</h1>

<div class="alert alert-danger">
    <h3>Are you sure you want to delete this account?</h3>
    <p>This action cannot be undone.</p>
</div>

<div>
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Account.Name)</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Account.Email)</dd>

        <dt class="col-sm-2">Phone</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Account.Phone)</dd>

        <dt class="col-sm-2">Industry</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Account.Industry)</dd>

        <dt class="col-sm-2">Website</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Account.Website)</dd>

        <dt class="col-sm-2">Address</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Account.Address)</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Account.Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>