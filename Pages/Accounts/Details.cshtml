@page
@model CRM_APP.Pages.Accounts.DetailsModel
@{
    ViewData["Title"] = "Account Details";
}

<h1>Account Details</h1>

<div>
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Account.Name)</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Account.Email)</dd>

        <dt class="col-sm-2">Phone</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Account.Phone)</dd>

        <dt class="col-sm-2">Industry</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Account.Industry)</dd>

        <dt class="col-sm-2">Website</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Account.Website)</dd>

        <dt class="col-sm-2">Address</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Account.Address)</dd>

        <dt class="col-sm-2">Created At</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Account.CreatedAt)</dd>
    </dl>
</div>
<p>
    <a asp-page="./Edit" asp-route-id="@Model.Account.Id" class="btn btn-warning">Edit</a>
    <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
</p>