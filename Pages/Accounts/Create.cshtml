@page
@model CRM_APP.Pages.Accounts.CreateModel
@{
    ViewData["Title"] = "Create Account";
}

<h1>Create Account</h1>

<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Account.Name" class="form-label"></label>
                <input asp-for="Account.Name" class="form-control" />
                <span asp-validation-for="Account.Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Account.Email" class="form-label"></label>
                <input asp-for="Account.Email" class="form-control" />
                <span asp-validation-for="Account.Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Account.Phone" class="form-label"></label>
                <input asp-for="Account.Phone" class="form-control" />
                <span asp-validation-for="Account.Phone" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Account.Industry" class="form-label"></label>
                <input asp-for="Account.Industry" class="form-control" />
                <span asp-validation-for="Account.Industry" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Account.Website" class="form-label"></label>
                <input asp-for="Account.Website" class="form-control" />
                <span asp-validation-for="Account.Website" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Account.Address" class="form-label"></label>
                <textarea asp-for="Account.Address" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Account.Address" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Create</button>
            <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}