@page
@model CRM_APP.Pages.Orders.CreateModel
@{
    ViewData["Title"] = "Create Order";
}

<h2>Create Order</h2>

<div asp-validation-summary="All" class="alert alert-danger"></div>

<form method="post">
    <div class="mb-3">
        <label asp-for="SelectedCustomerId" class="form-label">Customer</label>
        <select asp-for="SelectedCustomerId" class="form-control">
            <option value="0">-- Select Customer --</option>
            @foreach (var c in Model.CustomersList)
            {
                <option value="@c.Id">@c.Name</option>
            }
        </select>
        <span asp-validation-for="SelectedCustomerId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Order.OrderNumber" class="form-label"></label>
        <input asp-for="Order.OrderNumber" class="form-control" />
        <span asp-validation-for="Order.OrderNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Order.Quantity" class="form-label"></label>
        <input asp-for="Order.Quantity" id="Quantity" class="form-control" />
        <span asp-validation-for="Order.Quantity" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Order.UnitPrice" class="form-label"></label>
        <input asp-for="Order.UnitPrice" id="UnitPrice" class="form-control" step="0.01" />
        <span asp-validation-for="Order.UnitPrice" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Order.TotalPrice" class="form-label"></label>
        <input asp-for="Order.TotalPrice" id="TotalPrice" class="form-control" readonly />
    </div>

    <button type="submit" class="btn btn-primary">Save Order</button>
    <a asp-page="/Customers/Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const quantity = document.getElementById('Quantity');
        const price = document.getElementById('UnitPrice');
        const total = document.getElementById('TotalPrice');

        function calculateTotal() {
            let qty = parseFloat(quantity.value) || 0;
            let pr = parseFloat(price.value) || 0;
            total.value = (qty * pr).toFixed(2);
        }
        quantity.addEventListener('input', calculateTotal);
        price.addEventListener('input', calculateTotal);
        calculateTotal();
    </script>
}