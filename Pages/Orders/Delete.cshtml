@page "{id:int}"
@model CRM_APP.Pages.Orders.DeleteModel
@{
    ViewData["Title"] = "Delete Order";
}

<h2>Delete Order</h2>
<div class="alert alert-warning">
    Are you sure you want to delete order <strong>@Model.Order.OrderNumber</strong>?
</div>
<dl class="row">
    <dt class="col-sm-2">Customer</dt>
    <dd class="col-sm-10">@Model.Order.Customer?.Name</dd>
    <dt class="col-sm-2">Quantity</dt>
    <dd class="col-sm-10">@Model.Order.Quantity</dd>
    <dt class="col-sm-2">Total Price</dt>
    <dd class="col-sm-10">$@Model.Order.TotalPrice</dd>
</dl>
<form method="post">
    <input type="hidden" asp-for="Order.Id" />
    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a asp-page="/Customers/Index" class="btn btn-secondary">Cancel</a>
</form>