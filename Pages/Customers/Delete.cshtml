@page "{id:int}"
@model CRM_APP.Pages.Customers.DeleteModel
@{
    ViewData["Title"] = "Delete Customer";
}

<h2>Delete Customer</h2>
<div class="alert alert-warning">
    <strong>Warning:</strong> Deleting this customer will automatically delete all their orders (cascade delete).
</div>
<dl class="row">
    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Customer.Name</dd>
    <dt class="col-sm-2">Orders</dt>
    <dd class="col-sm-10">@Model.Customer.Orders?.Count orders will be deleted.</dd>
</dl>
<form method="post">
    <input type="hidden" name="id" value="@Model.Customer.Id" />
    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
</form>